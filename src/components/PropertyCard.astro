---
import Icon from "./Icon.astro";
import { formatPrice } from "../data/properties.js";
const { property: p } = Astro.props;
const href = `/listings/${p.slug}/`;
---
<article class="card lift group flex flex-col" data-reveal>
  <a href={href} class="relative block aspect-[4/3] overflow-hidden">
    <img
      src={p.images[0]}
      alt={`${p.address}, ${p.city}`}
      loading="lazy"
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
    <span
      class="absolute left-4 top-4 rounded-full bg-paper/95 px-3 py-1 text-xs font-semibold text-forest shadow-sm"
      >{p.status}</span
    >
    <span
      class="absolute right-4 top-4 rounded-full bg-ink/80 px-3 py-1 text-xs font-medium text-white backdrop-blur"
      >{p.type}</span
    >
  </a>
  <div class="flex flex-1 flex-col p-5">
    <p class="text-lg font-semibold text-ink">{formatPrice(p.price)}</p>
    <a href={href} class="mt-1 font-display text-lg text-ink hover:text-forest">
      {p.address}
    </a>
    <p class="mt-0.5 flex items-center gap-1.5 text-sm text-muted">
      <Icon name="pin" class="h-4 w-4 text-forest" />
      {p.neighborhood}, {p.city}
    </p>

    <div
      class="mt-4 flex items-center gap-4 border-t border-ink/8 pt-4 text-sm text-ink-soft"
    >
      <span class="flex items-center gap-1.5"><Icon name="bed" class="h-4 w-4 text-forest" />{p.beds} Beds</span>
      <span class="flex items-center gap-1.5"><Icon name="bath" class="h-4 w-4 text-forest" />{p.baths} Baths</span>
      <span class="flex items-center gap-1.5"><Icon name="area" class="h-4 w-4 text-forest" />{p.sqft.toLocaleString()} sqft</span>
    </div>
  </div>
</article>
