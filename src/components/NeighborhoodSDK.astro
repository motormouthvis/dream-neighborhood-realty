---
import { site } from "../data/site.js";
const dn = site.dreamNeighborhood;
---
{/*
  Dream Neighborhood popup — the entire integration is this one line.
  The SDK auto-detects the listing address from JSON-LD / OpenGraph /
  microdata on the page and renders a floating neighborhood button.
  On pages that contain an inline explorer (#dn-explorer) the popup is
  automatically suppressed (suppressOnInline). Set DN_DISABLE_POPUP in
  page front matter (see Base.astro) to opt a page out entirely.
*/}
<script
  src={dn.sdk}
  data-partner-id={dn.partnerId}
  data-accent-color={dn.accentColor}
  data-position={dn.position}
  async></script>
