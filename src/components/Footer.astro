---
import { site, nav } from "../data/site.js";
import Icon from "./Icon.astro";
const year = new Date().getFullYear();
const resources = [
  { label: "Buying", href: "/listings/" },
  { label: "Selling", href: "/contact/" },
  { label: "Neighborhood Explorer", href: "/neighborhood-explorer/" },
  { label: "About us", href: "/about/" },
];
---
<footer class="mt-24 bg-ink text-paper">
  <div class="container-page py-16">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-4">
      <div class="lg:pr-6">
        <a href="/" class="flex items-center gap-2.5">
          <span
            class="flex h-9 w-9 items-center justify-center rounded-xl bg-forest-light text-white"
          >
            <Icon name="home" class="h-5 w-5" />
          </span>
          <span class="font-display text-xl font-semibold text-white">{site.name}</span>
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-paper/60">
          {site.tagline} Every listing comes with a complete neighborhood story.
        </p>
        <div class="mt-5 flex gap-3">
          <a href={site.social.instagram} aria-label="Instagram" class="grid h-9 w-9 place-items-center rounded-full bg-white/10 text-white hover:bg-forest-light"><Icon name="instagram" class="h-4 w-4" /></a>
          <a href={site.social.facebook} aria-label="Facebook" class="grid h-9 w-9 place-items-center rounded-full bg-white/10 text-white hover:bg-forest-light"><Icon name="facebook" class="h-4 w-4" /></a>
          <a href={site.social.linkedin} aria-label="LinkedIn" class="grid h-9 w-9 place-items-center rounded-full bg-white/10 text-white hover:bg-forest-light"><Icon name="linkedin" class="h-4 w-4" /></a>
        </div>
      </div>

      <div>
        <h3 class="text-xs font-bold uppercase tracking-[0.2em] text-paper/50">Pages</h3>
        <ul class="mt-4 space-y-3 text-sm">
          {nav.map((item) => (
            <li><a href={item.href} class="text-paper/75 hover:text-white">{item.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-bold uppercase tracking-[0.2em] text-paper/50">Resources</h3>
        <ul class="mt-4 space-y-3 text-sm">
          {resources.map((item) => (
            <li><a href={item.href} class="text-paper/75 hover:text-white">{item.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-bold uppercase tracking-[0.2em] text-paper/50">Get in touch</h3>
        <ul class="mt-4 space-y-3 text-sm text-paper/75">
          <li class="flex items-start gap-2"><Icon name="pin" class="mt-0.5 h-4 w-4 text-forest-light" />{site.address}</li>
          <li><a href={`tel:${site.phone.replace(/[^0-9+]/g, "")}`} class="flex items-center gap-2 hover:text-white"><Icon name="phone" class="h-4 w-4 text-forest-light" />{site.phone}</a></li>
          <li><a href={`mailto:${site.email}`} class="flex items-center gap-2 hover:text-white"><Icon name="mail" class="h-4 w-4 text-forest-light" />{site.email}</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-14 flex flex-col items-start justify-between gap-4 border-t border-white/10 pt-6 text-sm text-paper/50 md:flex-row md:items-center">
      <p>© {year} {site.name}. A demo experience.</p>
      <p class="flex items-center gap-1.5">
        Neighborhood data powered by
        <a href="https://www.dreamneighborhood.com" target="_blank" rel="noopener" class="font-medium text-forest-light hover:text-white">Dream Neighborhood</a>
      </p>
    </div>
  </div>
</footer>
