---
import Icon from "./Icon.astro";

const { neighborhood: n, index = 99 } = Astro.props;
const href = `/neighborhood/${n.slug}/`;
const localityLine = `${n.anchorLocality}, ${n.anchorRegion}`;
const isFirst = index === 0;
---
<!-- No data-reveal: hub cards are above the fold; reveal CSS starts at opacity:0 and hid photos. -->
<article class="card lift group flex flex-col">
  <a href={href} class="relative block aspect-[4/3] w-full overflow-hidden bg-sand">
    {isFirst ? (
      <img
        src={n.cardImage}
        alt={`Photo for ${n.canonicalName}`}
        width={800}
        height={600}
        loading="eager"
        decoding="async"
        fetchpriority="high"
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
    ) : (
      <img
        src={n.cardImage}
        alt={`Photo for ${n.canonicalName}`}
        width={800}
        height={600}
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
    )}
    <span
      class="absolute left-4 top-4 rounded-full bg-paper/95 px-3 py-1 text-xs font-semibold text-forest shadow-sm"
      >Area guide</span
    >
    <span
      class="absolute right-4 top-4 rounded-full bg-ink/80 px-3 py-1 text-xs font-medium text-white backdrop-blur"
      >38+ data points</span
    >
  </a>
  <div class="flex flex-1 flex-col p-5">
    <span class="text-xs font-semibold uppercase tracking-[0.18em] text-forest">Neighborhood</span>
    <a href={href} class="mt-1.5 font-display text-xl text-ink hover:text-forest">
      {n.canonicalName}
    </a>
    <p class="mt-1 flex items-center gap-1.5 text-sm text-muted">
      <Icon name="pin" class="h-4 w-4 shrink-0 text-forest" />
      {localityLine}
    </p>

    <div
      class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-ink/8 pt-4 text-sm text-ink-soft"
    >
      <span class="flex items-center gap-1.5"><Icon name="layers" class="h-4 w-4 text-forest" /> Explorer</span>
      <span class="flex items-center gap-1.5"><Icon name="building" class="h-4 w-4 text-forest" /> Schools</span>
      <span class="flex items-center gap-1.5"><Icon name="trending" class="h-4 w-4 text-forest" /> Market</span>
    </div>

    <a
      href={href}
      class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-forest transition-colors hover:text-forest-dark"
      aria-label={`Explore ${n.canonicalName}`}
    >
      Explore area
      <Icon name="arrowUpRight" class="h-4 w-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
    </a>
  </div>
</article>
