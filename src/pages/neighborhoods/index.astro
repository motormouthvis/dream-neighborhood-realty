---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import NeighborhoodCard from "../../components/NeighborhoodCard.astro";
import { neighborhoods } from "../../data/neighborhoods.js";
---

<Base
  title="Neighborhoods"
  description="Browse DN Realty Los Angeles neighborhood guides — Hollywood Hills, Silver Lake, and Santa Monica — each with narrative context and the embedded Dream Neighborhood explorer."
  disablePopup={true}
>
  <section class="container-page py-14 sm:py-16" aria-labelledby="areas-heading">
    <div class="mx-auto max-w-2xl text-center">
      <span class="eyebrow justify-center"><Icon name="pin" class="h-4 w-4" /> Los Angeles</span>
      <h1
        id="areas-heading"
        class="mt-4 font-display text-4xl leading-tight text-ink sm:text-5xl"
      >
        Explore LA Neighborhoods
      </h1>
    </div>

    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {neighborhoods.map((n, index) => <NeighborhoodCard neighborhood={n} index={index} />)}
    </div>
  </section>
</Base>
