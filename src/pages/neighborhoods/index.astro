---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import NeighborhoodCard from "../../components/NeighborhoodCard.astro";
import { neighborhoods } from "../../data/neighborhoods.js";
---

<Base
  title="Neighborhoods"
  description="Browse DN Realty Los Angeles neighborhood guides — Hollywood Hills, Silver Lake, and Santa Monica — each with narrative context and the embedded Dream Neighborhood explorer."
  disablePopup={true}
>
  <section class="relative overflow-hidden border-b border-ink/8 bg-gradient-to-b from-cream via-paper to-paper">
    <div class="pointer-events-none absolute -right-24 top-0 h-72 w-72 rounded-full bg-forest/[0.06] blur-3xl" aria-hidden="true"></div>
    <div class="container-page relative py-14 sm:py-16">
      <span class="eyebrow"><Icon name="pin" class="h-4 w-4" /> Los Angeles</span>
      <h1 class="mt-4 max-w-3xl font-display text-4xl leading-tight text-ink sm:text-5xl">
        Neighborhood guides
      </h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-soft">
        Pick an area to read our on-page overview, then open the same embedded Dream Neighborhood explorer we use on
        listings — hyperlocal schools, safety, demographics, market trends, and commutes for that pocket of the city.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/neighborhood-explorer/"
          class="btn btn-ghost text-sm"
        >
          <Icon name="layers" class="h-4 w-4" />
          Full-screen explorer demo
        </a>
        <a href="/listings/" class="btn btn-ghost text-sm">
          <Icon name="home" class="h-4 w-4" />
          View listings
        </a>
      </div>
    </div>
  </section>

  <section class="container-page py-14 sm:py-16" aria-labelledby="areas-heading">
    <div class="flex flex-col items-start justify-between gap-4 border-b border-ink/8 pb-8 sm:flex-row sm:items-end">
      <div>
        <h2 id="areas-heading" class="font-display text-2xl text-ink sm:text-3xl">
          Choose a neighborhood
        </h2>
        <p class="mt-2 max-w-xl text-sm text-muted">
          Each card links to a dedicated URL with a clear slug (for example <code class="rounded bg-cream px-1.5 py-0.5 text-xs text-ink">/neighborhood/hollywood-hills-ca/</code>) so you can detect the area in analytics or app code.
        </p>
      </div>
    </div>

    <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {neighborhoods.map((n, index) => <NeighborhoodCard neighborhood={n} index={index} />)}
    </div>
  </section>
</Base>
