---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { site } from "../data/site.js";
---
<Base
  title="Contact"
  description="Get in touch with DN Realty to book a tour, list your home, or learn more about neighborhood data."
>
  <section class="container-page grid gap-12 py-16 lg:grid-cols-[1fr_1.1fr]">
    <div data-reveal>
      <span class="eyebrow">Contact</span>
      <h1 class="mt-3 font-display text-4xl text-ink sm:text-5xl">Let's find your fit.</h1>
      <p class="mt-5 max-w-md text-ink-soft">
        Whether you're buying, selling, or just exploring neighborhoods, our team is
        here to help. Send a note and we'll get back to you within one business day.
      </p>

      <div class="mt-8 space-y-4">
        <a href={`tel:${site.phone.replace(/[^0-9+]/g, "")}`} class="flex items-center gap-4 rounded-2xl border border-ink/8 bg-white p-4 hover:border-forest">
          <span class="grid h-11 w-11 place-items-center rounded-xl bg-forest/10 text-forest"><Icon name="phone" class="h-5 w-5" /></span>
          <span><span class="block text-xs text-muted">Call us</span><span class="font-medium text-ink">{site.phone}</span></span>
        </a>
        <a href={`mailto:${site.email}`} class="flex items-center gap-4 rounded-2xl border border-ink/8 bg-white p-4 hover:border-forest">
          <span class="grid h-11 w-11 place-items-center rounded-xl bg-forest/10 text-forest"><Icon name="mail" class="h-5 w-5" /></span>
          <span><span class="block text-xs text-muted">Email</span><span class="font-medium text-ink">{site.email}</span></span>
        </a>
        <div class="flex items-center gap-4 rounded-2xl border border-ink/8 bg-white p-4">
          <span class="grid h-11 w-11 place-items-center rounded-xl bg-forest/10 text-forest"><Icon name="pin" class="h-5 w-5" /></span>
          <span><span class="block text-xs text-muted">Office</span><span class="font-medium text-ink">{site.address}</span></span>
        </div>
      </div>
    </div>

    <div class="card p-7 sm:p-9" data-reveal>
      <h2 class="font-display text-2xl text-ink">Send a message</h2>
      <form class="mt-6 space-y-4" onsubmit="event.preventDefault(); this.reset(); document.getElementById('contact-ok').classList.remove('hidden');">
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block">
            <span class="text-sm font-medium text-ink-soft">Name</span>
            <input type="text" required class="mt-1.5 w-full rounded-xl border border-ink/12 bg-cream px-4 py-2.5 text-sm text-ink outline-none focus:border-forest" />
          </label>
          <label class="block">
            <span class="text-sm font-medium text-ink-soft">Phone</span>
            <input type="tel" class="mt-1.5 w-full rounded-xl border border-ink/12 bg-cream px-4 py-2.5 text-sm text-ink outline-none focus:border-forest" />
          </label>
        </div>
        <label class="block">
          <span class="text-sm font-medium text-ink-soft">Email</span>
          <input type="email" required class="mt-1.5 w-full rounded-xl border border-ink/12 bg-cream px-4 py-2.5 text-sm text-ink outline-none focus:border-forest" />
        </label>
        <label class="block">
          <span class="text-sm font-medium text-ink-soft">I'm interested in</span>
          <select class="mt-1.5 w-full rounded-xl border border-ink/12 bg-cream px-4 py-2.5 text-sm text-ink outline-none focus:border-forest">
            <option>Buying a home</option>
            <option>Selling a home</option>
            <option>Booking a tour</option>
            <option>Neighborhood data for my site</option>
          </select>
        </label>
        <label class="block">
          <span class="text-sm font-medium text-ink-soft">Message</span>
          <textarea rows="4" class="mt-1.5 w-full resize-none rounded-xl border border-ink/12 bg-cream px-4 py-2.5 text-sm text-ink outline-none focus:border-forest"></textarea>
        </label>
        <button type="submit" class="btn btn-primary w-full">Send message</button>
        <p id="contact-ok" class="hidden text-center text-sm text-forest">Thank you! Your message has been received.</p>
      </form>
    </div>
  </section>
</Base>
