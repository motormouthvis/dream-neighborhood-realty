---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import PropertyCard from "../components/PropertyCard.astro";
import { properties } from "../data/properties.js";
import { stats, propertyTypes, testimonials, articles, site } from "../data/site.js";

const featured = properties.filter((p) => p.featured).slice(0, 3);
const latest = properties.slice(0, 6);
---
<Base>
  <!-- HERO -->
  <section class="relative overflow-hidden">
    <div class="container-page grid items-center gap-10 py-14 lg:grid-cols-2 lg:py-20">
      <div data-reveal>
        <span class="eyebrow"><span class="h-px w-6 bg-forest"></span>Exclusive listings</span>
        <h1 class="mt-5 font-display text-4xl leading-[1.05] text-ink sm:text-5xl lg:text-6xl">
          Find your home with <span class="italic text-forest">confidence.</span>
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink-soft">
          DN Realty connects you with exclusive properties — and gives every listing
          a complete neighborhood story, so you know the area as well as the address
          before you ever book a tour.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/listings/" class="btn btn-primary">Browse listings <Icon name="arrow" class="h-4 w-4" /></a>
          <a href="/neighborhood-explorer/" class="btn btn-ghost">Try the Neighborhood Explorer</a>
        </div>
        <dl class="mt-10 flex flex-wrap gap-x-10 gap-y-4">
          {stats.slice(0, 3).map((s) => (
            <div>
              <dt class="font-display text-3xl text-ink">{s.value}</dt>
              <dd class="text-sm text-muted">{s.label}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="relative" data-reveal>
        <div class="overflow-hidden rounded-[2rem] shadow-card">
          <img
            src="https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?auto=format&fit=crop&w=1100&q=80"
            alt="A bright modern home"
            class="h-[420px] w-full object-cover sm:h-[520px]"
          />
        </div>
        <div class="absolute -bottom-6 left-4 right-4 rounded-2xl bg-paper/95 p-4 shadow-card backdrop-blur sm:left-6 sm:right-auto sm:w-72">
          <div class="flex items-center gap-3">
            <span class="grid h-11 w-11 place-items-center rounded-xl bg-forest text-white"><Icon name="layers" class="h-5 w-5" /></span>
            <div>
              <p class="text-sm font-semibold text-ink">38+ data points</p>
              <p class="text-xs text-muted">on every neighborhood</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Quick search bar -->
    <div class="container-page -mt-2 pb-6">
      <form action="/listings/" class="card flex flex-col gap-3 p-4 sm:flex-row sm:items-center sm:gap-2 sm:p-3" data-reveal>
        <label class="flex flex-1 items-center gap-2 rounded-xl px-3 py-2.5">
          <Icon name="search" class="h-5 w-5 text-forest" />
          <input type="text" name="q" placeholder="Search by city, neighborhood, or address" class="w-full bg-transparent text-sm text-ink outline-none placeholder:text-muted" />
        </label>
        <div class="hidden h-8 w-px bg-ink/10 sm:block"></div>
        <label class="flex items-center gap-2 rounded-xl px-3 py-2.5">
          <Icon name="home" class="h-5 w-5 text-forest" />
          <select name="type" class="bg-transparent text-sm text-ink outline-none">
            <option value="">Any type</option>
            {propertyTypes.map((t) => <option value={t.name}>{t.name}</option>)}
          </select>
        </label>
        <button type="submit" class="btn btn-primary">Search</button>
      </form>
    </div>
  </section>

  <!-- FEATURED -->
  <section class="container-page py-14">
    <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
      <div>
        <span class="eyebrow">Featured properties</span>
        <h2 class="mt-3 font-display text-3xl text-ink sm:text-4xl">Handpicked homes worth touring</h2>
      </div>
      <a href="/listings/" class="btn btn-ghost">View all <Icon name="arrow" class="h-4 w-4" /></a>
    </div>
    <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {featured.map((p) => <PropertyCard property={p} />)}
    </div>
  </section>

  <!-- NEIGHBORHOOD TECH SHOWCASE -->
  <section class="bg-ink py-20 text-paper">
    <div class="container-page grid items-center gap-12 lg:grid-cols-2">
      <div data-reveal>
        <span class="eyebrow text-forest-light"><span class="h-px w-6 bg-forest-light"></span>The DN difference</span>
        <h2 class="mt-5 font-display text-3xl text-white sm:text-4xl">
          Every listing comes with a complete neighborhood story.
        </h2>
        <p class="mt-5 max-w-xl text-paper/70">
          Buyers rank neighborhood quality as their #1 priority — so we surface it
          everywhere. Open any listing and a neighborhood button appears in the corner.
          One click reveals schools, crime, commute times, market trends, points of
          interest, and 30+ more hyperlocal data points, without ever leaving our site.
        </p>
        <ul class="mt-7 grid gap-3 sm:grid-cols-2">
          {[
            ["shield", "Crime & safety"],
            ["building", "Schools & education"],
            ["trending", "Market trends"],
            ["pin", "Points of interest"],
            ["users", "Population & demographics"],
            ["arrowUpRight", "Commute calculator"],
          ].map(([icon, label]) => (
            <li class="flex items-center gap-3 text-sm text-paper/85">
              <span class="grid h-9 w-9 place-items-center rounded-lg bg-white/10 text-forest-light"><Icon name={icon} class="h-4 w-4" /></span>
              {label}
            </li>
          ))}
        </ul>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/neighborhood-explorer/" class="btn btn-light">Open the live explorer</a>
          <a href="/listings/6947-oporto-drive/" class="btn btn-ghost border-white/25 text-white hover:border-white hover:text-white">See it on a listing</a>
        </div>
      </div>
      <div class="relative" data-reveal>
        <div class="overflow-hidden rounded-[2rem] border border-white/10 shadow-card">
          <img src="https://images.unsplash.com/photo-1524813686514-a57563d77965?auto=format&fit=crop&w=1100&q=80" alt="Map exploration of a neighborhood" class="h-[460px] w-full object-cover" />
        </div>
        <div class="absolute right-4 top-4 flex items-center gap-2 rounded-full bg-forest px-4 py-2 text-sm font-medium text-white shadow-lg">
          <Icon name="pin" class="h-4 w-4" /> Explore this neighborhood
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT / STATS -->
  <section class="container-page py-16">
    <div class="grid items-center gap-12 lg:grid-cols-2">
      <div class="grid grid-cols-2 gap-4" data-reveal>
        <img src="https://images.unsplash.com/photo-1582268611958-ebfd161ef9cf?auto=format&fit=crop&w=700&q=80" alt="Living room" class="mt-8 h-56 w-full rounded-2xl object-cover" />
        <img src="https://images.unsplash.com/photo-1556909212-d5b604d0c90d?auto=format&fit=crop&w=700&q=80" alt="Kitchen" class="h-56 w-full rounded-2xl object-cover" />
        <img src="https://images.unsplash.com/photo-1505691938895-1758d7feb511?auto=format&fit=crop&w=700&q=80" alt="Bedroom" class="h-56 w-full rounded-2xl object-cover" />
        <img src="https://images.unsplash.com/photo-1600210492493-0946911123ea?auto=format&fit=crop&w=700&q=80" alt="Exterior" class="-mt-8 h-56 w-full rounded-2xl object-cover" />
      </div>
      <div data-reveal>
        <span class="eyebrow">About us</span>
        <h2 class="mt-3 font-display text-3xl text-ink sm:text-4xl">A smarter, more transparent way to buy</h2>
        <p class="mt-4 text-ink-soft">
          We pair seasoned local agents with technology that puts the full picture in
          front of buyers. From advanced search to real-time market insights, every
          tool is designed to help you decide with confidence.
        </p>
        <div class="mt-8 space-y-5">
          <div class="flex gap-4">
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-forest/10 text-forest"><Icon name="sliders" class="h-5 w-5" /></span>
            <div>
              <h3 class="font-display text-lg text-ink">Advanced property search</h3>
              <p class="text-sm text-muted">Filter by location, price, size, and amenities to find the right fit fast.</p>
            </div>
          </div>
          <div class="flex gap-4">
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-forest/10 text-forest"><Icon name="trending" class="h-5 w-5" /></span>
            <div>
              <h3 class="font-display text-lg text-ink">Real-time market insights</h3>
              <p class="text-sm text-muted">Up-to-date trends, values, and neighborhood data to make informed decisions.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="mt-16 grid grid-cols-2 gap-4 rounded-[2rem] bg-cream p-8 sm:p-10 lg:grid-cols-4" data-reveal>
      {stats.map((s) => (
        <div class="text-center">
          <p class="font-display text-4xl text-forest">{s.value}</p>
          <p class="mt-1 text-sm text-ink-soft">{s.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- PROPERTY TYPES -->
  <section class="container-page py-12">
    <div class="text-center" data-reveal>
      <span class="eyebrow">Explore</span>
      <h2 class="mt-3 font-display text-3xl text-ink sm:text-4xl">Diverse property types</h2>
    </div>
    <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-7" data-reveal>
      {propertyTypes.map((t) => (
        <a href="/listings/" class="lift group flex flex-col items-center gap-3 rounded-2xl border border-ink/8 bg-white p-5 text-center">
          <span class="grid h-12 w-12 place-items-center rounded-xl bg-forest/10 text-forest transition-colors group-hover:bg-forest group-hover:text-white"><Icon name={t.icon} class="h-6 w-6" /></span>
          <span class="text-sm font-semibold text-ink">{t.name}</span>
          <span class="text-xs text-muted">{t.count} Properties</span>
        </a>
      ))}
    </div>
  </section>

  <!-- LATEST -->
  <section class="container-page py-14">
    <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
      <div>
        <span class="eyebrow">Latest properties</span>
        <h2 class="mt-3 font-display text-3xl text-ink sm:text-4xl">Just listed</h2>
      </div>
      <a href="/listings/" class="btn btn-ghost">View all <Icon name="arrow" class="h-4 w-4" /></a>
    </div>
    <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {latest.map((p) => <PropertyCard property={p} />)}
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="bg-cream py-20">
    <div class="container-page">
      <div class="text-center" data-reveal>
        <span class="eyebrow">Testimonials</span>
        <h2 class="mt-3 font-display text-3xl text-ink sm:text-4xl">Clients who found their fit</h2>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {testimonials.slice(0, 3).map((t) => (
          <figure class="flex flex-col rounded-2xl bg-white p-7 shadow-soft" data-reveal>
            <div class="flex gap-0.5 text-gold">
              {Array.from({ length: 5 }).map(() => <Icon name="star" class="h-4 w-4" />)}
            </div>
            <blockquote class="mt-4 flex-1 text-sm leading-relaxed text-ink-soft">"{t.quote}"</blockquote>
            <figcaption class="mt-5 border-t border-ink/8 pt-4">
              <p class="font-semibold text-ink">{t.name}</p>
              <p class="text-xs text-muted">{t.location}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ARTICLES -->
  <section class="container-page py-16">
    <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
      <div>
        <span class="eyebrow">News</span>
        <h2 class="mt-3 font-display text-3xl text-ink sm:text-4xl">Latest articles</h2>
      </div>
    </div>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {articles.map((a) => (
        <article class="card lift group flex flex-col" data-reveal>
          <div class="aspect-[16/10] overflow-hidden">
            <img src={a.image} alt={a.title} loading="lazy" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
          </div>
          <div class="flex flex-1 flex-col p-6">
            <div class="flex items-center gap-3 text-xs text-muted">
              <span class="rounded-full bg-forest/10 px-2.5 py-1 font-medium text-forest">{a.category}</span>
              <span>{a.date}</span>
            </div>
            <h3 class="mt-3 font-display text-lg leading-snug text-ink group-hover:text-forest">{a.title}</h3>
            <p class="mt-2 flex-1 text-sm text-muted">{a.excerpt}</p>
            <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-forest">Read more <Icon name="arrow" class="h-4 w-4" /></span>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="container-page pb-8">
    <div class="relative overflow-hidden rounded-[2rem] bg-forest px-6 py-16 text-center text-white sm:px-12" data-reveal>
      <div class="relative mx-auto max-w-2xl">
        <h2 class="font-display text-3xl text-white sm:text-4xl">Find your dream home today</h2>
        <p class="mt-4 text-paper/80">
          Thousands of listings across diverse property types — each with the full
          neighborhood picture. Your dream home is just a few clicks away.
        </p>
        <form class="mx-auto mt-8 flex max-w-md flex-col gap-3 sm:flex-row" onsubmit="event.preventDefault(); this.reset(); document.getElementById('nl-ok').classList.remove('hidden');">
          <input type="email" required placeholder="Enter your email" class="w-full rounded-full border border-white/25 bg-white/10 px-5 py-3 text-sm text-white placeholder:text-white/60 focus:border-white focus:outline-none" />
          <button type="submit" class="btn btn-light shrink-0">Join for updates</button>
        </form>
        <p id="nl-ok" class="mt-3 hidden text-sm text-paper/80">Thanks! Your submission has been received.</p>
      </div>
    </div>
  </section>
</Base>
