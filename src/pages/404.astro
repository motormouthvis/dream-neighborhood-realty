---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
---
<Base title="Page not found" disablePopup={true}>
  <section class="container-page flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
    <p class="font-display text-7xl text-forest">404</p>
    <h1 class="mt-4 font-display text-3xl text-ink sm:text-4xl">We couldn't find that page</h1>
    <p class="mt-3 max-w-md text-ink-soft">
      The page may have moved or never existed. Let's get you back to exploring homes
      and neighborhoods.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn btn-primary">Back home <Icon name="arrow" class="h-4 w-4" /></a>
      <a href="/listings/" class="btn btn-ghost">Browse listings</a>
    </div>
  </section>
</Base>
