---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import PropertyCard from "../../components/PropertyCard.astro";
import { properties, fullAddress } from "../../data/properties.js";
import { propertyTypes } from "../../data/site.js";

const cards = properties.map((p) => ({
  ...p,
  haystack:
    `${fullAddress(p)} ${p.neighborhood} ${p.type}`.toLowerCase(),
}));
---
<Base
  title="Listings"
  description="Browse exclusive DN Realty listings across Los Angeles — each with a full Dream Neighborhood data report."
>
  <section class="border-b border-ink/8 bg-cream">
    <div class="container-page py-12">
      <span class="eyebrow">Exclusive listings</span>
      <h1 class="mt-3 font-display text-4xl text-ink sm:text-5xl">Explore our properties</h1>
      <p class="mt-3 max-w-2xl text-ink-soft">
        Every home below includes a live neighborhood report — just open a listing and
        tap the neighborhood button to explore schools, safety, commutes, and more.
      </p>
    </div>
  </section>

  <section class="container-page py-10">
    <!-- Filter bar -->
    <div class="card mb-8 flex flex-col gap-3 p-4 sm:flex-row sm:items-center">
      <label class="flex flex-1 items-center gap-2 rounded-xl bg-cream px-3 py-2.5">
        <Icon name="search" class="h-5 w-5 text-forest" />
        <input id="f-search" type="text" placeholder="Search city, neighborhood, or address" class="w-full bg-transparent text-sm text-ink outline-none placeholder:text-muted" />
      </label>
      <label class="flex items-center gap-2 rounded-xl bg-cream px-3 py-2.5">
        <Icon name="home" class="h-5 w-5 text-forest" />
        <select id="f-type" class="bg-transparent text-sm text-ink outline-none">
          <option value="">Any type</option>
          {propertyTypes.map((t) => <option value={t.name}>{t.name}</option>)}
        </select>
      </label>
      <label class="flex items-center gap-2 rounded-xl bg-cream px-3 py-2.5">
        <Icon name="sliders" class="h-5 w-5 text-forest" />
        <select id="f-sort" class="bg-transparent text-sm text-ink outline-none">
          <option value="featured">Featured</option>
          <option value="low">Price: low to high</option>
          <option value="high">Price: high to low</option>
        </select>
      </label>
    </div>

    <p id="result-count" class="mb-6 text-sm text-muted"></p>

    <div id="grid" class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {cards.map((p) => (
        <div
          class="listing-item"
          data-haystack={p.haystack}
          data-type={p.type}
          data-price={p.price}
          data-featured={p.featured ? "1" : "0"}
        >
          <PropertyCard property={p} />
        </div>
      ))}
    </div>

    <div id="empty" class="hidden py-20 text-center">
      <p class="font-display text-2xl text-ink">No properties match your search</p>
      <p class="mt-2 text-muted">Try clearing the filters to see everything.</p>
    </div>
  </section>
</Base>

<script>
  const params = new URLSearchParams(location.search);
  const search = document.getElementById("f-search");
  const type = document.getElementById("f-type");
  const sort = document.getElementById("f-sort");
  const grid = document.getElementById("grid");
  const empty = document.getElementById("empty");
  const count = document.getElementById("result-count");
  const items = Array.from(document.querySelectorAll(".listing-item"));

  if (params.get("q")) search.value = params.get("q");
  if (params.get("type")) type.value = params.get("type");

  function apply() {
    const q = search.value.trim().toLowerCase();
    const t = type.value;
    let visible = 0;
    items.forEach((el) => {
      const matchQ = !q || el.dataset.haystack.includes(q);
      const matchT = !t || el.dataset.type === t;
      const show = matchQ && matchT;
      el.style.display = show ? "" : "none";
      if (show) visible++;
    });

    const shown = items.filter((el) => el.style.display !== "none");
    const s = sort.value;
    if (s !== "featured") {
      shown.sort((a, b) =>
        s === "low"
          ? a.dataset.price - b.dataset.price
          : b.dataset.price - a.dataset.price,
      );
    } else {
      shown.sort((a, b) => b.dataset.featured - a.dataset.featured);
    }
    shown.forEach((el) => grid.appendChild(el));

    empty.classList.toggle("hidden", visible > 0);
    count.textContent = `${visible} ${visible === 1 ? "property" : "properties"} available`;
  }

  [search, type, sort].forEach((el) =>
    el.addEventListener("input", apply),
  );
  apply();
</script>
