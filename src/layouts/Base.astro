---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site.js";
import { fullAddress } from "../data/properties.js";

const {
  title,
  description = site.description,
  image = "https://images.unsplash.com/photo-1568605114967-8130f3a36994?auto=format&fit=crop&w=1200&q=80",
  listing = null,
  /** Geocodable anchor for neighborhood pages (Open Graph + JSON-LD Place). */
  place = null,
  disablePopup = false,
} = Astro.props;

// Use ASCII " | " so document.title stays valid for third-party parsers (e.g. DN
// Explorer SDK reads title before JSON-LD); avoid middot if encoding ever slips.
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} — ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, site.url).href;

// When a listing is supplied, emit address signals the Dream Neighborhood
// SDK reads (OpenGraph + JSON-LD) so the popup resolves the exact address.
const listingJsonLd = listing
  ? {
      "@context": "https://schema.org",
      "@type": "SingleFamilyResidence",
      name: fullAddress(listing),
      address: {
        "@type": "PostalAddress",
        streetAddress: listing.address,
        addressLocality: listing.city,
        addressRegion: listing.state,
        postalCode: listing.zip,
        addressCountry: "US",
      },
    }
  : null;

const placeJsonLd =
  place && !listing
    ? {
        "@context": "https://schema.org",
        "@type": "Place",
        name: place.name,
        address: {
          "@type": "PostalAddress",
          streetAddress: place.streetAddress,
          addressLocality: place.addressLocality,
          addressRegion: place.addressRegion,
          postalCode: place.postalCode,
          addressCountry: "US",
        },
      }
    : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    {listing && (
      <>
        <meta property="og:street-address" content={listing.address} />
        <meta property="og:locality" content={listing.city} />
        <meta property="og:region" content={listing.state} />
        <meta property="og:postal-code" content={listing.zip} />
        <script type="application/ld+json" set:html={JSON.stringify(listingJsonLd)} />
      </>
    )}

    {place && !listing && (
      <>
        <meta property="og:street-address" content={place.streetAddress} />
        <meta property="og:locality" content={place.addressLocality} />
        <meta property="og:region" content={place.addressRegion} />
        <meta property="og:postal-code" content={place.postalCode} />
        <meta name="geo.placename" content={place.name} />
        <script type="application/ld+json" set:html={JSON.stringify(placeJsonLd)} />
      </>
    )}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..600&family=Urbanist:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-forest focus:px-4 focus:py-2 focus:text-white"
      >Skip to content</a
    >
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    {!disablePopup && (
      <script src='https://app.dreamneighborhood.com/explorer/sdk.js' async is:inline></script>
    )}

    <script>
      // Reveal-on-scroll progressive enhancement.
      const els = document.querySelectorAll("[data-reveal]");
      if (els.length && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.1 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add("is-visible"));
      }
    </script>
  </body>
</html>
